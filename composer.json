{
    "name": "tiagof2/f2-politool",
    "description": "Some helpers for Laravel and [some] for without Laravel projects",
    "license": "MIT",
    "keywords": [
        "classes",
        "enums",
        "helpers",
        "laravel",
        "tools",
        "tiagof2"
    ],
    "homepage": "https://github.com/tiagofrancafernandes/f2-politool",
    "authors": [
        {
            "name": "Tiago França",
            "email": "dev+composer-politool@tiagofranca.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "TiagoF2\\Expansions\\": "src/Expansions/",
            "TiagoF2\\Helpers\\": "src/Helpers/",
            "TiagoF2\\StaticModel\\": "src/StaticModel/"
        },
        "files": [
            "src/global_functions/helpers.php"
        ]
    },
    "require": {
        "php": "^7.2|^8.0|^8.1|^8.2|^8.3",
        "ext-json": "*",
        "illuminate/contracts": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/pagination": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/support": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/http": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/macroable": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/config": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/collections": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/process": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "illuminate/pipeline": "^5.8|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0|^2.0",
        "barryvdh/laravel-ide-helper": "^2.0|^3.0|^4.0"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    }
}
